#!/usr/bin/env bash
# Prepares an Amp orb to build and test this app: PHP 8.5, Composer, Node deps, .env, SQLite, and Vite assets.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() { echo "==> $1 ($(date +%T))"; }

php_packages=(php8.5-cli php8.5-sqlite3 php8.5-mbstring php8.5-xml php8.5-curl php8.5-zip php8.5-intl)

if ! dpkg -s "${php_packages[@]}" >/dev/null 2>&1; then
  step "Installing PHP 8.5 from packages.sury.org"
  if [ ! -f /etc/apt/sources.list.d/php.list ]; then
    curl -fsSLo /tmp/debsuryorg-archive-keyring.deb https://packages.sury.org/debsuryorg-archive-keyring.deb
    sudo dpkg -i /tmp/debsuryorg-archive-keyring.deb >/dev/null
    rm -f /tmp/debsuryorg-archive-keyring.deb
    echo "deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ $(. /etc/os-release && echo "$VERSION_CODENAME") main" |
      sudo tee /etc/apt/sources.list.d/php.list >/dev/null
  fi
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${php_packages[@]}" >/dev/null
fi

if ! command -v composer >/dev/null 2>&1; then
  step "Installing Composer"
  curl -fsSL https://getcomposer.org/installer | php -- --quiet --install-dir=/tmp --filename=composer
  sudo mv /tmp/composer /usr/local/bin/composer
fi

step "composer install"
composer install --no-interaction --prefer-dist --no-progress

step "npm ci"
npm ci --audit false --fund false --no-progress

[ -f .env ] || cp -- .env.example .env
if ! grep -q '^APP_KEY=base64:' .env; then
  step "Generating APP_KEY"
  php artisan key:generate --no-interaction
fi

step "Migrating SQLite database"
[ -f database/database.sqlite ] || touch database/database.sqlite
php artisan migrate --force --no-interaction

step "Building Vite assets"
npm run build

step "Done"
